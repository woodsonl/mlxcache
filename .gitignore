# Rust
/target/
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Design review scratch dirs (process artifacts, not repo content)
*.review.*

# macOS
.DS_Store

# Local env
.env
bench/*.json

# gstack tool output (QA and deploy reports); children, not the dir itself,
# so reviewed config files can be re-included below
.gstack/*

# lane declarations are reviewed repo config, not tool output
!.gstack/pregate.json

# runtime flock target for timing probes; a stale pid inside is display-only
probe.lock
