<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mlxcache.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>cargo</string>
    <string>run</string>
    <string>--release</string>
    <string>-p</string>
    <string>mlxcache-daemon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/lance/Repos/mlxcache</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MLXCACHE_ADDR</key>
    <string>127.0.0.1:8420</string>
    <!-- Set to the model(s) this daemon serves. Empty means every request 404s. -->
    <key>MLXCACHE_MODELS</key>
    <string>REPLACE_WITH_MODEL_ID</string>
    <!-- Set to the sidecar base URL. Do not set an empty string: an empty
         value builds a client whose URLs are malformed. Omit the key entirely
         to run with no adapter (requests then 503 with a clear message). -->
    <key>MLXCACHE_SIDECAR_URL</key>
    <string>http://127.0.0.1:8421</string>
    <!-- Durable checkpoint dir; the default /tmp/mlxcache-blobs is wiped on reboot. -->
    <key>MLXCACHE_BLOBS</key>
    <string>/Users/lance/Library/Application Support/mlxcache/blobs</string>
    <!-- Shutdown grace must be UNDER ExitTimeOut below, or launchd SIGKILLs
         before the daemon finishes draining. -->
    <key>MLXCACHE_SHUTDOWN_GRACE_S</key>
    <string>25</string>
    <key>RUST_LOG</key>
    <string>info</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <!-- Seconds launchd waits after SIGTERM before SIGKILL. Must exceed
       MLXCACHE_SHUTDOWN_GRACE_S so the daemon exits on its own terms. -->
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/tmp/mlxcache-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mlxcache-daemon.err</string>
</dict>
</plist>
